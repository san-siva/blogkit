{
	"name": "@san-siva/blogkit",
	"version": "1.1.31",
	"description": "A reusable blog component library for React/Next.js applications with code highlighting, diagrams, and rich content features",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"types": "dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.js"
		},
		"./styles.css": {
			"import": "./dist/esm/index.css",
			"require": "./dist/cjs/index.css"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "rollup -c && tsc --emitDeclarationOnly --outDir dist/types && cp -r src/assets dist/",
		"dev": "rollup -c -w",
		"lint": "tsc --noEmit",
		"prepublishOnly": "npm ci && npm run lint && npm run build"
	},
	"keywords": [
		"blog",
		"react",
		"nextjs",
		"components",
		"markdown",
		"code-highlighting",
		"mermaid",
		"diagrams"
	],
	"author": "Santhosh Siva",
	"license": "MIT",
	"dependencies": {
		"@san-siva/stylekit": "^1.0.12",
		"schema-dts": "^1.1.5"
	},
	"peerDependencies": {
		"@react-spring/web": "^10.0.0",
		"mermaid": "^10.0.0",
		"next": ">=16.0.10",
		"prismjs": "^1.29.0",
		"react": ">=19.0.0",
		"react-dom": ">=19.0.0",
		"react-syntax-highlighter": "^15.5.0"
	},
	"devDependencies": {
		"@rollup/plugin-commonjs": "^28.0.1",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-node-resolve": "^15.3.0",
		"@rollup/plugin-typescript": "^12.1.1",
		"@types/node": "^22.10.1",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@types/react-syntax-highlighter": "^15.5.13",
		"mermaid": "^10.0.0",
		"postcss": "^8.4.49",
		"postcss-url": "^10.1.3",
		"rollup": "^4.27.4",
		"rollup-plugin-peer-deps-external": "^2.2.4",
		"rollup-plugin-postcss": "^4.0.2",
		"rollup-plugin-url": "^3.0.1",
		"sass": "^1.77.8",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2"
	}
}
